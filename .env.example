# ============================================================================
# Consult Dave Platform - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git - it contains secrets!
# ============================================================================

# ---------- SUPABASE (Database + Auth + Storage) ----------
# Find these in your Supabase project dashboard under Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# This is the service_role key - keep it SECRET. Only used in server-side code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------- SUPABASE STORAGE BUCKETS ----------
# The names of your Supabase Storage buckets (create these in the Supabase dashboard)
NEXT_PUBLIC_STORAGE_BUCKET_CARS=car-images
NEXT_PUBLIC_STORAGE_BUCKET_EQUIPMENT=equipment-images
NEXT_PUBLIC_STORAGE_BUCKET_AVATARS=avatars

# ---------- PAYSTACK (Payments) ----------
# Sign up at https://paystack.com to get your keys
# Use test keys for development, live keys for production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# ---------- SENDGRID (Email) ----------
# Sign up at https://sendgrid.com to get your API key
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@consultdave.com

# ---------- SITE CONFIG ----------
# The URL where your frontend is hosted
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The environment: "development", "staging", or "production"
NEXT_PUBLIC_ENVIRONMENT=development
